# Build artifacts (generated by build.py - committed for Cloudflare Pages)
# Note: We commit generated HTML so Pages can serve without Python at build time
# Uncomment below if you switch to running build.py during CF Pages build:
# index.html
# about.html
# tools/*.html
# en/
# sitemap.xml
# robots.txt

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
seo_performance_report.txt

# OpenClaw local agent scratch files
.openclaw/

# Helper scripts (add_tool.py etc.)
scripts/add_tool*.py
